// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
}

// @id=dms_rule_1 @name=^org\.gnome\.
window-rule {
    match app-id="^org\\.gnome\\."
    open-floating true
    geometry-corner-radius 12
    clip-to-geometry true
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="^nm-connection-editor$"
    default-column-width { proportion 0.5; }
}

// @id=dms_rule_4 @name=
window-rule {
    match app-id="kitty"
    draw-border-with-background false
}

// @id=dms_rule_7 @name=
window-rule {
    match app-id="^dev.deedles.Trayscale$"
    open-floating true
}

// @id=wr_1772091854384135510 @name=FreeCAD
window-rule {
    match app-id="^org.freecad.FreeCAD$"
    open-floating true
}

// @id=wr_1773183308072071541 @name=Thunderbird
window-rule {
    match app-id="^org.mozilla.Thunderbird$"
    open-floating true
}

// @id=dms_rule_11 @name=Opacity on inactive windows
window-rule {
    match is-active=false
    opacity 1.00
}

// @id=dms_rule_6 @name=org.quickshell$
window-rule {
    match app-id="org.quickshell$"
    opacity 1.00
    open-floating true
}

// @id=wr_1777169346535425165 @name=com.mitchellh.ghostty
window-rule {
    match app-id="^com.mitchellh.ghostty$"
    opacity 0.92
}

// @id=wr_1783356025418077764 @name=[live] Zen Picture-in-Picture
window-rule {
    match app-id="^zen$" title="^Picture-in-Picture$"
    open-floating true
    max-width 900
    max-height 600
}

// @id=wr_1783356324179718201 @name=[Live] - Zen Extensions
window-rule {
    match app-id="^zen$" title="^Extension:"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 900; }
    block-out-from "screencast"
    geometry-corner-radius 10
}

// @id=wr_1783528842256755188 @name=org.kde.partitionmanager
window-rule {
    match app-id="^org.kde.partitionmanager$"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

// @id=wr_1783553565314058203 @name=com.danklinux.dms
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
    default-column-width { fixed 940; }
    default-window-height { fixed 1420; }
}

// @id=wr_1785032089537752729 @name=org.openrgb.OpenRGB
window-rule {
    match app-id="^org.openrgb.OpenRGB$" is-floating=true
}

// @id=wr_1785034650367553669 @name=nvidia-settings
window-rule {
    match app-id="^nvidia-settings$" is-floating=true
}

// @id=wr_1785629283868293602 @name=Hydrobuddy
window-rule {
    match app-id="^Hydrobuddy$"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
    min-width 800
    min-height 600
}

// @id=wr_1787938581949539207 @name=Zoom screenshare annotate_toolbar
window-rule {
    match app-id="^zoom$" title="^annotate_toolbar$"
    open-floating true
    open-focused false
    default-floating-position x=0 y=622 relative-to="top"
    default-column-width { fixed 150; }
    default-window-height { fixed 150; }
    min-width 150
    max-width 150
    min-height 150
    max-height 150
    border { off; }
    focus-ring { off; }
    shadow { off; }
}

// @id=wr_1787970280110257280 @name=org.cachyos.hello
window-rule {
    match app-id="^org.cachyos.hello$"
    open-floating true
}

// @id=wr_1788200538958705673 @name=Zoom meeting bottombar popup
window-rule {
    match app-id="^zoom$" title="^meeting bottombar popup$"
    open-floating true
    open-focused false
    default-column-width { fixed 300; }
    default-window-height { fixed 300; }
    min-width 300
    max-width 300
    min-height 300
    max-height 300
    border {
        on
        width 0
        active-color "#1a1a1a"
        inactive-color "#1a1a1a"
    }
    draw-border-with-background true
    focus-ring { off; }
    shadow { off; }
}
