#!/usr/bin/env bash
# One-time setup after `stow` on a fresh machine. Idempotent.
#  - seeds generated files that config.kdl `include`s but git ignores
#    (DMS overwrites them on first theme apply)
#  - makes the DMS display-profile symlink relative (DMS writes it absolute)
#  - enables the pre-commit hook
set -euo pipefail
repo=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
niri_dms=~/.config/niri/dms

if [ ! -e "$niri_dms/colors.kdl" ]; then
    install -m644 "$repo/scripts/templates/niri-colors.kdl" "$niri_dms/colors.kdl"
    echo "seeded $niri_dms/colors.kdl (DMS will regenerate it)"
fi

if [ -L "$niri_dms/outputs.kdl" ]; then
    target=$(readlink "$niri_dms/outputs.kdl")
    case $target in
        /*) rel=profiles/$(basename "$target")
            ln -sfn "$rel" "$niri_dms/outputs.kdl"
            echo "outputs.kdl -> $rel (was absolute)";;
    esac
    [ -e "$niri_dms/outputs.kdl" ] || echo "WARN: outputs.kdl -> $(readlink "$niri_dms/outputs.kdl") is dangling; pick a display profile in DMS Settings" >&2
fi

git -C "$repo" config core.hooksPath .githooks
command -v niri >/dev/null && niri validate -c ~/.config/niri/config.kdl >/dev/null 2>&1 && echo "niri config valid"
